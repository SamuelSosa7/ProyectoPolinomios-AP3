public class Forma1{
    //atributos
    private int Du, VPF1[];
    
    public Forma1(int Grado){
        Du = Grado + 1;
        VPF1 = new int[Du+1];
        VPF1[0] = Grado;
    }

    public int getDu() {
        return Du;
    }

    public void setDu(int Du) {
        this.Du = Du;
    }

    public int[] getVPF1() {
        return VPF1;
    }

    public void setVPF1(int[] VPF1) {
        this.VPF1 = VPF1;
    }
    
    public int getVPF1(int i) {
        return VPF1[i];
    }
    
    public void setVPF1(int i, int d){
        VPF1[i] = d;
    }
    
    //METODO CREAR POLINOMIO FORMA1
    public void Crear( String Vs[] ){
        int contador = 0;
        for(int i=0; i<Vs.length; i++){
            if( Vs[i] != null){
                contador++;
            }
        }
        int n = contador / 2;
        
        int coef[]= new int[n];
        int exp[] = new int[n];
        
        int j=0;
        for(int i=0; i < contador; i+=2){
            coef[j] = Integer.parseInt(Vs[i]);
            exp[j] = Integer.parseInt(Vs[i+1]);
            j++;
        }
        
        int mayor = exp[0];

      
        VPF1 = new int[mayor + 2];   // +1 para el grado en posición 0
        VPF1[0] = mayor;

        for (int e = mayor; e >= 0; e--) {

            boolean encontrado = false;

            for (int i = 0; i < n; i++) {
                if (exp[i] == e) {
                    VPF1[mayor - e + 1] = coef[i];
                    encontrado = true;
                    break;
                }
            }

            if (!encontrado) {
                VPF1[mayor - e + 1] = 0;
            }
        }
    }
    
        //METODO INSERTAR TERMINO
    public String Insertar(){
        int c = Integer.parseInt(JOptionPane.showInputDialog("Ingrese coeficiente"));
        int e = Integer.parseInt(JOptionPane.showInputDialog("Ingrese exponente"));
    
        if (e < 0) {
            JOptionPane.showMessageDialog(null, "Exponente no puede ser negativo ");
            return "error";
        }
        int Grado = VPF1[0];
        if (e > Grado) {
            int nuevoGrado = e;
            int VPF1Nuevo[] = new int[nuevoGrado + 2];
            VPF1Nuevo[0] = nuevoGrado;
            for (int i = 1; i < VPF1.length; i++) {
                int expo = Grado - i;
                int posi = nuevoGrado - expo;
                VPF1Nuevo[posi] = VPF1[i];
            }
            VPF1 = VPF1Nuevo;
            Grado = nuevoGrado;
            Du = nuevoGrado + 1;
        }
        int posi = (Grado - e) + 1;
        VPF1[posi] += c;
        return "Registro insertado ";
    }
    
    //METODO ELIMINAR TERMINO
    public void Eliminar(String Vs[]){
        int e = Integer.parseInt(JOptionPane.showInputDialog("Ingrese el exponente a eliminar: "));
        int grado = VPF1[0];
        
        if( e >= 0 && e < grado + 1){
            int pos = grado - e + 1;
            
            if( VPF1[pos] != 0){
                Vs[pos] = "0";
                VPF1[pos]= 0;
            }
            JOptionPane.showMessageDialog(null, "Exponente eliminado");
        } else{
            JOptionPane.showMessageDialog(null, "El exponente no existe");
        }
        
        if( e == grado){
            int nuevoGrado = 0;
            int inicio = 0;
            
            for(int i=1; i < VPF1.length; i++){
                if(VPF1[i] != 0){
                    nuevoGrado = grado - (i-1);
                    inicio= i;
                    break;
                }
            }
            int VPF1Nuevo[] = new int[nuevoGrado + 2];
            VPF1Nuevo[0] = nuevoGrado;
            Du = nuevoGrado + 1;
            int j=1;
            for(int i=inicio; i < VPF1.length; i++){
                VPF1Nuevo[j] = VPF1[i];
                j++;
            }
            VPF1 = VPF1Nuevo;
        }
    }
    
    //METODO MOSTRAR FORMA 1
    public void Mostrar(){
        String mensaje= "";
        System.out.println("Vector FORMA 1: ");
        
        for(int i=0; i < VPF1.length; i++){
            mensaje += "|" + VPF1[i] + "|";
        }
        JOptionPane.showMessageDialog(null, mensaje);
    }
    
    //METODO RECONSTRUIR
   public void Reconstruir(){
       String polinomio= "";
       int grado = VPF1[0];
       for(int i=1; i < VPF1.length; i++){
           int coe =  VPF1[i];
           int exp = grado - (i-1);
           
           if( coe != 0){
               if( coe > 0 && polinomio.equals("")){
                   polinomio += "+";
               }
               if( exp == 0){
                   polinomio += coe;
               } else if( exp == 1){
                   if( coe == 1){
                       polinomio += "x";
                   } else if( coe == -1){
                       polinomio += "-x";
                   } else{
                       polinomio += coe + "x";
                   } 
               } else{
                   if(  coe == 1){
                       polinomio += "x^" + exp;
                   } else if( coe == -1){
                       polinomio += "-x^" + exp;
                   } else{
                       polinomio += coe + "x^" + exp;
                   }
               }
           }
       }
       JOptionPane.showMessageDialog(null, "Polinomio reconstruido: " + polinomio);
   } 
   
   //METODO EVALUAR
   public void Evaluar(){
       int x = Integer.parseInt(JOptionPane.showInputDialog("Ingrese el numero a evaluar: "));
       int grado= VPF1[0];
       int resultado = 0;
       for(int i=1; i < VPF1.length ; i++){
           int coe = VPF1[i];
           int exp = grado - (i-1);
           resultado += coe * Math.pow(x, exp);
       }
       JOptionPane.showMessageDialog(null, "El resultado del polinomio con " + x + "como valor, es: " + resultado);
   }
    
   //METODO SUMAR FORMA 1
   public Forma1 Sumar(Forma1 F2){
       int Grado1 = VPF1[0];
       int Grado2 = F2.VPF1[0];
       int GradoMax;
       
       if( Grado1 < Grado2){
           GradoMax = Grado2;
       } else{
           GradoMax = Grado1;
       }
       
       Forma1 resultado = new Forma1(GradoMax);
       
       for(int i=1; i < VPF1.length; i++){
           int exp = Grado1 - (i-1);        // A.DU - i
           int pos = GradoMax - exp + 1;    //DU - Exp
           resultado.getVPF1()[pos] += VPF1[i];
       }
       
       for(int j=1; j < F2.getVPF1().length ; j++){
           int exp = Grado2 - (j-1);        // B.DU - i
           int pos = GradoMax - exp + 1;    //DU - Exp
           resultado.getVPF1()[pos] += F2.getVPF1(j);
       }
       return resultado;
   }
    
   //METODO MULTIPLICAR FORMA 1
   public Forma1 Multiplicar(Forma1 F2) {
        int Grado1 = VPF1[0];
        int Grado2 = F2.getVPF1(0);
        int GradoMax = Grado1 + Grado2;

        Forma1 resultado = new Forma1(GradoMax);

        for (int i = 1; i < VPF1.length; i++) {
            for (int j = 1; j < F2.getVPF1().length; j++) {
                int coe = VPF1[i] * F2.getVPF1(j);
                int exp = Grado1 - (i - 1) + Grado2 - (j - 1); //(A.DU - i) + (B.DU - j)
                int posi = GradoMax - exp + 1;
                
                resultado.getVPF1()[posi] += coe;
            }
        }

        return resultado;
    }
   
   //Forma 1 terminado 
   public Forma1 SumarF2F3(Forma2 F2, Forma3 F3){
        int grado;

        if (F2.getVPF2()[2] > F3.getPunta().getExp()) {
            grado = F2.getVPF2()[2];
        } else {
            grado = F3.getPunta().getExp();
        }

        Forma1 F1 = new Forma1(grado);

        int V2[] = F2.getVPF2();

        for (int i = 1; i < V2.length; i += 2) {
            int coef = V2[i];
            int exp = V2[i + 1];
            int pos = (grado + 1) - exp;

            F1.getVPF1()[pos] += coef;
        }

        Nodo nodo = F3.getPunta();

        while (nodo != null) {
            int coef = nodo.getCoe();
            int exp = nodo.getExp();
            int pos = (grado + 1) - exp;

            F1.getVPF1()[pos] += coef;
            nodo = nodo.getLiga();
        }

        return F1;
    }
   
   
}
