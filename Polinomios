    public static String[] Ingresar() {
        
        String Cadena = JOptionPane.showInputDialog("Ingrese polinomio");
        char Vc[] = Cadena.toCharArray();
        String Vs[] = new String[Vc.length], s = "";
        int j = 0;
        for (int i = 0; i < Vc.length; i++) {
            System.out.print("[" + Vc[i] + "]");
        }

        //VALIDACION POR SI APARECE UN SIGNO Y YA HABIA ALGO GUARDADO
        for (int i = 0; i < Vc.length; i++) {
            if ((Vc[i] == '-' || Vc[i] == '+') && !s.isEmpty()) {
                Vs[j] = s;
                j++;
                Vs[j] = "0";
                j++;
                s = "";
            }
            //VALIDACION SI APARECE MENOS O MAS 
            if (Vc[i] == '-' || Vc[i] == '+' || Character.isDigit(Vc[i])) {
                s = s + Vc[i];
            } else { //VALIDACION SI ES IGUAL A X
                if (Vc[i] == 'x') {
                    if (s.equals("-") || s.equals("+") || s.isEmpty()) {
                        s = s + "1";
                    }

                    Vs[j] = s;
                    j++;
                    s = "";
                    //VALIDACION PARA NO ESCRIBIR ^1 o ^0
                    if (i == Vc.length - 1 || Vc[i + 1] != '^') {
                        Vs[j] = "1";
                        j++;
                    } else {
                        String exp = Character.toString(Vc[i + 2]);
                        i = i + 2;

                        //VALIDACION SI EL EXPONENTE TIENE 2 NUMEROS
                        if (i + 1 < Vc.length && Character.isDigit(Vc[i + 1])) {
                            exp = exp + Vc[i + 1];
                            i++;
                        }

                        Vs[j] = exp;
                        j++;
                    }
                }
            }
        }
        //VALIDACION TERMINO INDEPENDIENTE
        if (!s.isEmpty()) {
            Vs[j] = s;
            j++;
            Vs[j] = "0";
        }

        System.out.println("\n");
        for (int i = 0; i < Vs.length; i++) {
            System.out.print("|" + Vs[i] + "|");
        }

        //ORDENAR POLINOMIO
        
            
        
        String AuxCoe = "";
        String AuxExp = "";
        for (int i = 1; Vs[i] != null; i += 2) {
            for (int k = i; k < Vs.length && Vs[k] != null; k += 2) {
                if (Integer.parseInt(Vs[i]) > Integer.parseInt(Vs[k])) {
                    AuxCoe = Vs[i - 1];
                    AuxExp = Vs[i];
                    Vs[i - 1] = Vs[k - 1];
                    Vs[i] = Vs[k];
                    Vs[k - 1] = AuxCoe;
                    Vs[k] = AuxExp;
                }

            }
        }

        return Vs;
        
    }
    
    public static int ContarTerminos(String Vs[]){
        int NumTer = 0;
        for (int i = 1; Vs[i] != null; i += 2) {
            NumTer++;
        }
        return NumTer;
    }
    
    
    
